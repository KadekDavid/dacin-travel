{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "incremental": false,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "lib/**/*.ts", "data/articles.ts"],
  "exclude": ["node_modules", ".next", ".test-build"]
}
